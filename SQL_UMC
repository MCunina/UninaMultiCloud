-- QUERY:

-- Q1. Registrazione di un nuovo utente + corso di laurea
INSERT INTO utente (matricola, nome, cognome, email, password)
VALUES (:matricola, :nome, :cognome, :email, :passwordHash);

INSERT INTO corsoLaurea (matricola, corsoLaurea)
VALUES (:matricola, :corsoLaurea);

-- Q2. Login
SELECT matricola, nome, cognome, password
FROM utente
WHERE email = :email;

-- Q3. Aggiornamento della password 
UPDATE utente
SET password = :nuovoPasswordHash
WHERE matricola = :matricola;

-- Q4. Corsi di laurea associati a un utente
SELECT corsoLaurea
FROM corsoLaurea
WHERE matricola = :matricola;

-- Q5. Cancellazione di un utente
DELETE FROM utente 
WHERE matricola = :matricola;

-- Q6. Caricamento di un nuovo elemento multimediale
INSERT INTO elementoMultimediale
    (titolo, descrizione, formato, durata, dataCreazione, urlFile, urlCopertina, matricolaAutore)
VALUES
    (:titolo, :descrizione, :formato, :durata, :dataCreazione, :urlFile, :urlCopertina, :matricolaAutore);

-- Q7. Modifica dei parametri di un elementoMultimediale
UPDATE elementoMultimediale
SET titolo = :nuovoTitolo, descrizione = :nuovaDescrizione
WHERE idElementoMultimediale = :idElemento 
  AND matricolaAutore = :matricolaAutore;

-- Q8. Eliminazione di un elemento
DELETE FROM elementoMultimediale
WHERE idElementoMultimediale = :idElemento 
  AND matricolaAutore = :matricolaAutore;

-- Q9. Tutti gli elementi caricati da un determinato utente, ordine decrescente (più recenti prima)
SELECT idElementoMultimediale, titolo, formato, dataCreazione
FROM elementoMultimediale
WHERE matricolaAutore = :matricola
ORDER BY dataCreazione DESC;

-- Q10. Ricerca di elementi
SELECT idElementoMultimediale, titolo, formato, matricolaAutore
FROM elementoMultimediale
WHERE titolo LIKE CONCAT('%', :parolaChiave, '%');

-- Q11. Dettaglio di un elemento con autore e numero totale di riproduzioni
SELECT
    e.idElementoMultimediale,
    e.titolo,
    e.formato,
    e.durata,
    e.dataCreazione,
    u.nome,
    u.cognome,
    (SELECT MAX(v) FROM (VALUES (SUM(a.numeroRiproduzioni)), (0)) AS t(v)) AS totaleRiproduzioni
FROM elementoMultimediale e
JOIN utente u ON u.matricola = e.matricolaAutore
LEFT JOIN ascolti a ON a.idElementoMultimediale = e.idElementoMultimediale
WHERE e.idElementoMultimediale = :idElemento
GROUP BY e.idElementoMultimediale, e.titolo, e.formato, e.durata, e.dataCreazione, u.nome, u.cognome;

-- Q12. Creazione di una nuova playlist
INSERT INTO playlist (titolo, visibilita, matricolaProprietario)
VALUES (:titoloPlaylist, :visibilita, :matricolaProprietario);

-- Q13. Aggiunta di un elemento a una playlist
INSERT INTO composizionePlaylist (idPlaylist, idElementoMultimediale, posizione)
SELECT 
    :idPlaylist, 
    :idElemento, 
    (SELECT MAX(v) FROM (VALUES (MAX(posizione)), (0)) AS t(v)) + 1
FROM composizionePlaylist
WHERE idPlaylist = :idPlaylist;

-- Q14. Rimozione di un elemento da una playlist
DELETE FROM composizionePlaylist
WHERE idPlaylist = :idPlaylist AND idElementoMultimediale = :idElemento;

-- Q15. Contenuto di una playlist, nell'ordine previsto
SELECT
    cp.posizione,
    e.idElementoMultimediale,
    e.titolo,
    e.formato,
    e.durata
FROM composizionePlaylist cp
JOIN elementoMultimediale e ON e.idElementoMultimediale = cp.idElementoMultimediale
WHERE cp.idPlaylist = :idPlaylist
ORDER BY cp.posizione;

-- Q16. Cambio di visibilità di una playlist
UPDATE playlist
SET visibilita = :nuovaVisibilita
WHERE idPlaylist = :idPlaylist AND matricolaProprietario = :matricolaProprietario;

-- Q17. Eliminazione di una playlist
DELETE FROM playlist
WHERE idPlaylist = :idPlaylist AND matricolaProprietario = :matricolaProprietario;

-- Q18. Concessione dell'accesso a una playlist condivisa a un utente
INSERT INTO accessoPlaylist (idPlaylist, matricola)
VALUES (:idPlaylist, :matricolaOspite);

-- Q19. Revoca dell'accesso a una playlist condivisa
DELETE FROM accessoPlaylist
WHERE idPlaylist = :idPlaylist AND matricola = :matricolaOspite;

-- Q20. Utenti autorizzati su una playlist condivisa
SELECT u.matricola, u.nome, u.cognome
FROM accessoPlaylist ap
JOIN utente u ON u.matricola = ap.matricola
WHERE ap.idPlaylist = :idPlaylist;

-- Q21. Tutte le playlist visibili a un dato utente
SELECT DISTINCT p.idPlaylist, p.titolo, p.visibilita, p.matricolaProprietario
FROM playlist p
LEFT JOIN accessoPlaylist ap
       ON ap.idPlaylist = p.idPlaylist AND ap.matricola = :matricolaUtente
WHERE p.matricolaProprietario = :matricolaUtente
   OR p.visibilita = 'PUBBLICA'
   OR (p.visibilita = 'CONDIVISA' AND ap.matricola IS NOT NULL);

-- Q23. Top N elementi più riprodotti in assoluto
SELECT
    e.idElementoMultimediale,
    e.titolo,
    e.formato,
    SUM(a.numeroRiproduzioni) AS totaleRiproduzioni
FROM ascolti a
JOIN elementoMultimediale e ON e.idElementoMultimediale = a.idElementoMultimediale
GROUP BY e.idElementoMultimediale, e.titolo, e.formato
ORDER BY totaleRiproduzioni DESC
LIMIT :limiteElementi;

-- Q24. Cronologia di ascolto di un utente, dal più recente
SELECT
    e.titolo,
    e.formato,
    a.numeroRiproduzioni,
    a.dataUltimoAscolto
FROM ascolti a
JOIN elementoMultimediale e ON e.idElementoMultimediale = a.idElementoMultimediale
WHERE a.matricola = :matricola
ORDER BY a.dataUltimoAscolto DESC;

-- Q25. Distribuzione degli elementi caricati per formato (Audio / Video)
SELECT formato, COUNT(*) AS numeroElementi
FROM elementoMultimediale
GROUP BY formato;

-- Q26. Utenti con il maggior numero di playlist create
SELECT u.matricola, u.nome, u.cognome, COUNT(p.idPlaylist) AS numeroPlaylist
FROM utente u
JOIN playlist p ON p.matricolaProprietario = u.matricola
GROUP BY u.matricola, u.nome, u.cognome
ORDER BY numeroPlaylist DESC;

-- Q27. Durata complessiva (in secondi) del contenuto presente in una playlist
SELECT p.idPlaylist, p.titolo, SUM(e.durata) AS durataTotaleSecondi
FROM playlist p
JOIN composizionePlaylist cp ON cp.idPlaylist = p.idPlaylist
JOIN elementoMultimediale e ON e.idElementoMultimediale = cp.idElementoMultimediale
WHERE p.idPlaylist = :idPlaylist
GROUP BY p.idPlaylist, p.titolo;

-- Q28. Modifica accesso playlist 
INSERT INTO accessoPlaylist (idPlaylist, idUtente)
SELECT 
    :idPlaylist, 
    :idUtente
FROM playlist
WHERE idPlaylist = :idPlaylist 
  AND visibilita = 'CONDIVISA';
